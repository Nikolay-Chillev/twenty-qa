{
  "name": "twenty-qa",
  "version": "0.0.0",
  "private": true,
  "description": "Test automation for the Twenty CRM: API, permissions, UI, email, accessibility and performance",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "allure-playwright": "3.13.0",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.6.7"
  }
}
